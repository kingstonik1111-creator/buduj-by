#!/bin/bash
cd "$(dirname "$0")" || exit 1
clear
echo "======================================================"
echo "  BUDUJ.BY · страницы мастеров"
echo "======================================================"
echo
echo "Беру данные из базы и пересобираю папку master/"
echo

python3 seo/masters.py
CODE=$?

echo
if [ $CODE -ne 0 ]; then
  echo "------------------------------------------------------"
  echo "Скрипт завершился с ошибкой."
  echo "Частые причины: нет интернета или база временно недоступна."
  echo "Попробуй ещё раз через пару минут."
else
  echo "------------------------------------------------------"
  echo "Готово."
  echo
  echo "Дальше: открой GitHub Desktop, закоммить изменения"
  echo "и запушь — страницы появятся на сайте через пару минут."
fi

echo
echo "Окно можно закрыть."
